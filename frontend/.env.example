# Copy to .env.local and fill in. Never commit real values.

# Supabase (public URL + anon key are safe for the browser; the service role key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local services
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ASSISTANT_API_BASE=http://localhost:8787
EMAIL_IO_BASE_URL=http://localhost:3001

# Shared secrets (generate long random values)
INTERNAL_API_KEY=
TOKEN_ENCRYPTION_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# AI
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# Platform owner: exact email addresses, comma separated (never a whole domain)
NEXT_PUBLIC_SYSTEM_FOUNDER_ALLOWLIST=

# Optional: show the UI with example data without login (local only, never in production)
# ELYRA_LOCAL_PREVIEW=1
