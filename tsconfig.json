{
  "compilerOptions": {
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "worker/**/*",
    "frontend/**/*",
    "email-io/**/*",
    "api-gateway/**/*"
  ],
  "exclude": [
    "api-gateway/server.js",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "frontend/scripts/**"
  ]
}
