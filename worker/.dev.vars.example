# Local worker variables for `wrangler dev`. Copy this file to `.dev.vars` and fill in real secrets.
# Ensure your local wrangler config binds an `ASSISTANT_KV` namespace (see worker/LOCAL_DEV.md).
OPENAI_API_KEY=
NOTION_TOKEN=
DEFAULT_USER_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID_EXTERNAL=
GOOGLE_CLIENT_SECRET_EXTERNAL=
GOOGLE_CLIENT_FORCE_EXTERNAL=0
GOOGLE_REDIRECT_URI=http://localhost:8787/assistant/oauth/google/callback
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
ENVIRONMENT=dev
ALLOW_DANGEROUS_ADMIN=0
EMAIL_IO_BASE_URL=http://localhost:3001
INTERNAL_API_KEY=
INTERNAL_API_SECRET=

# Local Postgres + MinIO (optional local runtime path).
DATABASE_URL=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

MODEL_PROVIDER=openai

# Feature Flags
FF_MULTI_WORKSPACE=1
FF_MAIL=1
FF_CALENDAR=1
